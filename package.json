{
	"name": "@nvisy/synthetic",
	"version": "0.1.0",
	"description": "Synthetic document corpus generator and redaction benchmark harness",
	"type": "module",
	"private": true,
	"keywords": [
		"nvisy",
		"benchmark",
		"synthetic-data",
		"ground-truth",
		"redaction",
		"anonymization",
		"pii",
		"phi",
		"evaluation",
		"document-processing"
	],
	"author": "Nvisy <support@nvisy.com>",
	"license": "MIT",
	"homepage": "https://github.com/nvisycom/synthetic#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nvisycom/synthetic.git"
	},
	"bugs": {
		"url": "https://github.com/nvisycom/synthetic/issues"
	},
	"bin": {
		"synthetic": "./dist/main.js"
	},
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"start": "node --experimental-strip-types src/main.ts",
		"build": "tsdown",
		"build:watch": "tsdown --watch",
		"dev": "tsdown --watch",
		"test": "vitest run",
		"test:watch": "vitest --watch",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"test:e2e": "vitest run --config vitest.e2e.config.ts",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
		"clean": "rimraf dist"
	},
	"dependencies": {
		"@faker-js/faker": "^10.6.0",
		"@nvisy/sdk": "^0.45.0",
		"citty": "^0.2.2",
		"consola": "^3.4.2",
		"pure-rand": "^8.4.2",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@types/node": "^26.4.1",
		"@vitest/coverage-v8": "^5.0.0",
		"@vitest/ui": "^5.0.0",
		"license-checker-rseidelsohn": "^5.0.1",
		"rimraf": "^6.1.3",
		"tsdown": "^0.23.0",
		"typescript": "^5.9.3",
		"vitest": "^5.0.0"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
