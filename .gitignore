# Output
dist/
build/
output/

# Rendered corpora, benchmark runs, and the reports scored from them. All
# three are derived: a corpus is reproducible from the tracked specifications
# in data/ plus a seed, a run from a corpus, and a report from the two. They
# also grow with the corpus — rendered scans and audio reach gigabytes, and a
# report carries a row per planted value — so none belongs in git.
corpus/
runs/
report/

# Generation writes here and renames it into place, so a failure cannot leave a
# manifest from one run beside records from another. It should never survive a
# run, but a killed process can strand one.
*.staging/

# Python
.venv/
__pycache__/
.ruff_cache/
__marimo__/

# Environment
.env*
!.env.example

# Logs
logs/
*.log
*.log*

